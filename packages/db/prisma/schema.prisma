// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider             = "prisma-client"
  output               = "../generated/prisma"
  importFileExtension  = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
 id	Int @id @default(autoincrement())
 name	String
 email  String
 password String
 zaps Zap[]
}

model Zap {
 id String @id @default(uuid())
 triggerId String
 userId Int
 trigger Trigger?
 actions Action[]
 zapRuns ZapRun[]
 user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Trigger {
 id String @id @default(uuid())
 zapId String @unique
 triggerId String
 type AvailableTrigger @relation(fields :[triggerId], references:[id])
 zap Zap @relation(fields :[zapId], references:[id], onDelete: Cascade, onUpdate: Cascade)
 metadata Json?
}

model Action {
  id String @id @default(uuid())
  zapId String
  actionId String
  type AvaialableAction @relation(fields: [actionId], references: [id])
  zap Zap @relation(fields: [zapId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  metadata Json?
  sortingOrder Int @default(0)
}

model AvailableTrigger {
 id String @id @default(uuid())
 name String
 image String
 triggers Trigger[] 
}

model AvaialableAction {
 id String @id @default(uuid())
 name String
 image String
 action Action[] 
}

model ZapRun {
  id String @id @default(uuid())
  zapId String
  metadata Json
  zap Zap @relation(fields: [zapId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  zapRunOutBox ZapRunOutBox?
  zapRunExecutions ZapRunExecution []
}

model ZapRunExecution{
  id String @id @default(uuid())
  zapRunId String
  stepOrder Int
  zapRun ZapRun @relation(fields: [zapRunId], references: [id])
  status Status
  message String?
  @@unique([zapRunId,stepOrder])
}

model ZapRunOutBox {
  id String @id @default(uuid())
  zapRunId String @unique
  zapRun ZapRun @relation(fields: [zapRunId], references: [id])
}

enum Status {
  PROCESSING
  SUCCESS
  FAIL
}
