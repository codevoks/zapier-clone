# Copy this file to .env and fill in the values you need.
# `docker compose up -d` starts Postgres + Kafka with the defaults below.

# ---- Postgres ----
POSTGRES_USER=zapier
POSTGRES_PASSWORD=zapier
POSTGRES_DB=zapier
DATABASE_URL=postgresql://zapier:zapier@localhost:5432/zapier?schema=public

# ---- Auth ----
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=zap-events
KAFKA_CLIENT_ID=zapier-clone
KAFKA_CONSUMER_GROUP=zap-worker
# Set to "true" only if you want a fresh consumer group to replay the whole topic.
KAFKA_FROM_BEGINNING=false

# ---- Hooks service (webhook ingestion) ----
HOOKS_PORT=4000
# Shown in the web UI as the base of each zap's webhook URL. Must match
# HOOKS_PORT above (Next.js inlines NEXT_PUBLIC_* at build time).
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:4000

# ---- Outbox processor ----
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_STALE_MS=30000

# ---- Actions (all optional - only needed to exercise that specific action) ----
# HTTP action needs nothing; it just POSTs to whatever URL the Zap is configured with.
ACTION_HTTP_TIMEOUT_MS=10000

# Email action (https://resend.com - free tier, no card required)
RESEND_KEY=
SEND_EMAIL=

# Solana action (use devnet - free faucet, no real funds)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SENDER_PRIVATE_KEY=
