    "@repo/validation": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "axios": "^1.13.4",
    "next": "16.3.3",
    "postcss": "^8.5.6",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dotenv-cli": "^8.0.0",
